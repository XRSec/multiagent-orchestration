{
  "panels": [
    "chat",
    "explorer",
    "terminal"
  ],
  "activePanel": "chat",
  "theme": "system",
  "defaultWorkingDir": ".",
  "allowedWritePaths": [
    ".git/",
    "scripts/",
    "CHANGELOG.md"
  ],
  "disallowedWritePaths": [
    "src/",
    "~/.claude",
    ".env"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
