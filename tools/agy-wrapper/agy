#!/usr/bin/env node
// # Generated by Antigravity-Manager (Native Resilience & Auto-Continue)
/*
export GEMINI_API_KEY=""
export GOOGLE_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
export GOOGLE_GEMINI_MODEL="gemini-3.8-flash-high"
export DO_NOT_TRACK=1
export GEMINI_TELEMETRY_ENABLED=false
RAW_MODEL="gemini-3.8-flash-high"
*/

import { spawn, spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// 确保本地 bin 目录在 PATH 中（优先环境变量或脚本所在目录）
const localBin = process.env.AGY_LOCAL_BIN ? expandHome(process.env.AGY_LOCAL_BIN) : null;
for (const binDir of [__dirname, localBin]) {
  if (binDir && !process.env.PATH?.split(path.delimiter).includes(binDir)) {
    process.env.PATH = `${binDir}${path.delimiter}${process.env.PATH || ''}`;
  }
}

// 从脚本自身注释块中提取 Antigravity-Manager 配置的 RAW_MODEL / GOOGLE_GEMINI_MODEL
function loadEmbeddedConfig() {
  try {
    const content = fs.readFileSync(__filename, 'utf8');
    const rawMatch = content.match(/^\s*RAW_MODEL\s*=\s*['"]?([^'"\r\n]+)['"]?/m);
    const envMatch = content.match(/^\s*export\s+GOOGLE_GEMINI_MODEL\s*=\s*['"]?([^'"\r\n]+)['"]?/m);
    const urlMatch = content.match(/^\s*export\s+GOOGLE_GEMINI_BASE_URL\s*=\s*['"]?([^'"\r\n]+)['"]?/m);
    const keyMatch = content.match(/^\s*export\s+GEMINI_API_KEY\s*=\s*['"]?([^'"\r\n]*)['"]?/m);
    return {
      rawModel: rawMatch?.[1] || envMatch?.[1] || 'gemini-3.8-flash-high',
      baseUrl: urlMatch?.[1] || 'https://generativelanguage.googleapis.com',
      apiKey: keyMatch?.[1] ?? '',
    };
  } catch {
    return {
      rawModel: 'gemini-3.8-flash-high',
      baseUrl: 'https://generativelanguage.googleapis.com',
      apiKey: '',
    };
  }
}

const config = loadEmbeddedConfig();
process.env.GEMINI_API_KEY = process.env.GEMINI_API_KEY ?? config.apiKey;
process.env.GOOGLE_GEMINI_BASE_URL = process.env.GOOGLE_GEMINI_BASE_URL || config.baseUrl;
process.env.GOOGLE_GEMINI_MODEL = process.env.GOOGLE_GEMINI_MODEL || config.rawModel;
process.env.DO_NOT_TRACK = '1';
process.env.GEMINI_TELEMETRY_ENABLED = 'false';

const AGY_BIN = process.env.AGY_CLI_BIN || path.join(__dirname, 'agy_cli');
const LOG_DIR = process.env.AGY_LOG_DIR || '/tmp';

function resolveAtBin() {
  const envBin = process.env.AGY_AT_BIN || process.env.ANTIGRAVITY_TOOLS_BIN;
  if (envBin) return expandHome(envBin);

  for (const candidate of ['antigravity-tools', 'at']) {
    const res = spawnSync('which', [candidate], { stdio: 'ignore' });
    if (res.status === 0) return candidate;
  }
  return null;
}

const SUBCOMMANDS = new Set([
  'agent', 'agents', 'changelog', 'help', 'install',
  'mcp', 'mic-serve', 'models', 'plugin', 'plugins', 'remote-control', 'update',
]);

const rawUserArgs = process.argv.slice(2);

function isHelpOrVersion(args) {
  return args.some((a) => a === '--help' || a === '-h' || a === '--version' || a === '-v');
}

function isAcpMode(args) {
  if (isHelpOrVersion(args)) return false;
  const firstPositional = args.find((a) => !a.startsWith('-'));
  return firstPositional === 'acp';
}

function isSubcommandOrHelp(args) {
  if (isHelpOrVersion(args)) {
    return true;
  }
  const firstPositional = args.find((a) => !a.startsWith('-'));
  return firstPositional ? SUBCOMMANDS.has(firstPositional) : false;
}

function isPrintMode(args) {
  return args.some(
    (a) =>
      a === '-p' ||
      a === '--print' ||
      a === '--prompt' ||
      a.startsWith('--print=') ||
      a.startsWith('--prompt=')
  );
}

function hasModelFlag(args) {
  return args.some((a) => a === '--model' || a.startsWith('--model='));
}

function hasLogFileFlag(args) {
  for (let i = 0; i < args.length; i++) {
    if ((args[i] === '--log-file' || args[i] === '--cli_log_file') && args[i + 1]) return args[i + 1];
    if (args[i].startsWith('--log-file=')) return args[i].slice('--log-file='.length);
    if (args[i].startsWith('--cli_log_file=')) return args[i].slice('--cli_log_file='.length);
  }
  return null;
}

function buildModelArgs(rawModel, args) {
  if (hasModelFlag(args)) return [];
  const match = rawModel.match(/^(.*)-(high|medium|low|xhigh|max)$/);
  if (match) {
    return ['--model', match[1], '--effort', match[2]];
  }
  return ['--model', rawModel];
}

function createLogFilePath(attempt, prefix = 'cli') {
  fs.mkdirSync(LOG_DIR, { recursive: true });
  return path.join(LOG_DIR, `agy-${prefix}-${process.pid}-${attempt}.log`);
}

// KEEP IN SYNC with paseo-agy-acp/server/error-inspection.ts RETRYABLE_ERROR_TOKENS
const RETRYABLE_TOKENS = [
  'UNAVAILABLE',
  'RESOURCE_EXHAUSTED',
  '\\b503\\b',
  '\\b429\\b',
  'rate limit',
  'capacity',
  'high traffic',
  'try again',
];
const RETRYABLE_MATCHER = new RegExp(RETRYABLE_TOKENS.join('|'), 'i');
// Narrow capacity-only signals derived from the shared vocabulary: bare `UNAVAILABLE`
// and bare `capacity` are deliberately excluded so benign text cannot rotate the keychain.
// 429/RESOURCE_EXHAUSTED stays owned by QUOTA_EXHAUSTED, which is evaluated first.
const CAPACITY_SIGNAL_TOKENS = [
  '\\b503\\b',
  'high traffic',
  'No capacity available',
  'Service Unavailable',
];
const UNAVAILABLE_CAPACITY_MATCHER = new RegExp(CAPACITY_SIGNAL_TOKENS.join('|'), 'i');

// 解析单行日志，返回识别到的状态更新或错误对象
function inspectLogLine(line, state) {
  const emailMatch =
    line.match(/applyAuthResult:\s*email=([^\s,]+)/) ||
    line.match(/OAuth:\s*authenticated successfully as\s+([^\s]+)/);
  if (emailMatch) {
    state.email = emailMatch[1];
  }

  const convMatch =
    line.match(/Created conversation ([0-9a-f-]{36})/) ||
    line.match(/Streaming conversation ([0-9a-f-]{36})/) ||
    line.match(/Sending user message to conversation ([0-9a-f-]{36})/) ||
    line.match(/Loading\/Resuming session:\s*([0-9a-f-]{36})/) ||
    line.match(/Print mode:\s*conversation=([0-9a-f-]{36})/);
  if (convMatch) {
    state.conversationId = convMatch[1];
  }

  const resolvedModelMatch =
    line.match(/Resolving model ([^\s]+)/) ||
    line.match(/Advertising available models to client:\s*current=([^\s,]+)/);
  if (resolvedModelMatch) {
    state.model = resolvedModelMatch[1];
  }
  const labelModelMatch =
    line.match(/Propagating selected model override to backend:\s*label="([^"]+)"/) ||
    line.match(/Setting default model override:\s*(.+)$/);
  if (labelModelMatch) {
    state.modelLabel = labelModelMatch[1].trim();
  }
  const acpSwitchMatch = line.match(/Switching model in session [^ ]+ to:\s*([^(]+)/);
  if (acpSwitchMatch) {
    state.modelLabel = acpSwitchMatch[1].trim();
  }

  // 忽略后台非致命的 FetchConfig / aicode scope warning
  if (line.includes('code_assist_client.go') && line.includes('FetchConfig failed')) {
    return;
  }
  if (line.includes('You are not logged into Antigravity') && !line.includes('silent auth failed')) {
    return;
  }

  // 2. 账号被禁用 / 403 PERMISSION_DENIED
  if (
    /This service has been disabled in this account/i.test(line) ||
    /violation of Terms of Service/i.test(line) ||
    /(?:agent executor error|generating and executing|Print mode: run ended with error).*PERMISSION_DENIED/i.test(line) ||
    /ACCOUNT_DISABLED|USER_PROJECT_DENIED/i.test(line)
  ) {
    state.error = {
      category: 'ACCOUNT_DISABLED',
      code: 403,
      label: '账号已被禁用/封禁 (403 PERMISSION_DENIED)',
      detail: extractCleanError(line),
      shouldSwitch: true,
      killInteractive: true,
    };
    return;
  }

  // 3. 配额耗尽 / 429 RESOURCE_EXHAUSTED / 速率限制
  if (
    /(?:agent executor error|generating and executing|Print mode: run ended with error).*(?:RESOURCE_EXHAUSTED|429|quota|rate limit|exhausted)/i.test(line) ||
    /RESOURCE_EXHAUSTED\s*\(code\s*429\)/i.test(line) ||
    /exhausted your capacity|quota exceeded|Too Many Requests/i.test(line)
  ) {
    state.error = {
      category: 'QUOTA_EXHAUSTED',
      code: 429,
      label: '配额耗尽/触发限流 (429 RESOURCE_EXHAUSTED)',
      detail: extractCleanError(line),
      shouldSwitch: true,
      killInteractive: true,
    };
    return;
  }

  // 3b. 上游容量耗尽 / 503 UNAVAILABLE（不杀交互进程）
  if (RETRYABLE_MATCHER.test(line) && UNAVAILABLE_CAPACITY_MATCHER.test(line)) {
    state.error = {
      category: 'UNAVAILABLE_CAPACITY',
      code: 503,
      label: '上游容量耗尽/服务不可用 (503 UNAVAILABLE)',
      detail: extractCleanError(line),
      shouldSwitch: true,
      killInteractive: false,
    };
    return;
  }

  // 4. 账号需验证 (Validation Required)
  if (/validation_required|verify your account|further action is required/i.test(line)) {
    state.error = {
      category: 'VALIDATION_REQUIRED',
      code: 403,
      label: '账号触发验证拦截 (Validation Required)',
      detail: extractCleanError(line),
      shouldSwitch: true,
      killInteractive: true,
    };
    return;
  }

  // 5. 认证失效 / 401 UNAUTHENTICATED
  if (
    /(?:agent executor error|generating and executing|Print mode: run ended with error).*UNAUTHENTICATED/i.test(line) ||
    /Print mode: silent auth failed/i.test(line) ||
    /oauth2:.*invalid_grant/i.test(line)
  ) {
    state.error = {
      category: 'AUTH_FAILED',
      code: 401,
      label: '账号登录态失效 (401 UNAUTHENTICATED)',
      detail: extractCleanError(line),
      shouldSwitch: true,
      killInteractive: true,
    };
    return;
  }
}

function extractCleanError(line) {
  return line
    .replace(/^[IWEF]\d{4}\s+[\d:.]+\s+\d+\s+[^\]]+\]\s*/, '')
    .replace(/^agent executor error:\s*generating and executing:\s*/i, '')
    .replace(/^generating and executing:\s*/i, '')
    .replace(/^Print mode:\s*run ended with error and no response:\s*/i, '')
    .trim();
}

function hasAntigravityTools() {
  const atBin = resolveAtBin();
  if (!atBin) return false;
  if (atBin.includes(path.sep)) {
    return fs.existsSync(atBin);
  }
  const res = spawnSync('which', [atBin], { stdio: 'ignore' });
  return res.status === 0;
}

const SWITCH_LOCK_DIR = path.join(LOG_DIR, 'agy-switch.lock.d');
const SWITCH_STATE_FILE = path.join(LOG_DIR, 'agy-switch-state.json');
const SWITCH_COOLDOWN_MS = Number(process.env.AGY_SWITCH_COOLDOWN_MS || 15000);
// Known limitation: the cooldown key includes fromEmail, so after a successful rotation
// a concurrent process holding the new account can pass the same-account check and
// switch again. This is intentionally not fixed here; the lock still serializes writers.
const SWITCH_RESUME_DELAY_MS = Number(process.env.AGY_SWITCH_RESUME_DELAY_MS || 3000);

function sleepSync(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function acquireSwitchLock(timeoutMs = 5000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    try {
      fs.mkdirSync(SWITCH_LOCK_DIR);
      return true;
    } catch (err) {
      if (err?.code !== 'EEXIST') return false;
      try {
        const stat = fs.statSync(SWITCH_LOCK_DIR);
        if (Date.now() - stat.mtimeMs > 30000) {
          fs.rmSync(SWITCH_LOCK_DIR, { recursive: true, force: true });
          continue;
        }
      } catch {}
      sleepSync(80);
    }
  }
  return false;
}

function releaseSwitchLock() {
  try {
    fs.rmSync(SWITCH_LOCK_DIR, { recursive: true, force: true });
  } catch {}
}

function readSwitchState() {
  try {
    return JSON.parse(fs.readFileSync(SWITCH_STATE_FILE, 'utf8'));
  } catch {
    return null;
  }
}

function writeSwitchState(state) {
  try {
    fs.writeFileSync(SWITCH_STATE_FILE, JSON.stringify(state), 'utf8');
  } catch {}
}

function switchAccount(fromEmail = null) {
  const atBin = resolveAtBin();
  if (!atBin) return { ok: false, skipped: false };

  const locked = acquireSwitchLock();
  try {
    const prev = readSwitchState();
    if (prev && typeof prev.timestamp === 'number') {
      const elapsed = Date.now() - prev.timestamp;
      const sameExhaustedAccount =
        !fromEmail || !prev.fromEmail || prev.fromEmail === fromEmail;
      if (elapsed >= 0 && elapsed < SWITCH_COOLDOWN_MS && sameExhaustedAccount) {
        const sec = (elapsed / 1000).toFixed(1);
        console.error(
          `\x1b[33m[Antigravity] 检测到并发会话已在 ${sec}s 前切号，跳过重复切号。\x1b[0m`
        );
        return { ok: true, skipped: true };
      }
    }

    const res = spawnSync(atBin, ['switch', '--target', 'agy'], {
      stdio: ['inherit', 'stderr', 'stderr'],
    });
    if (res.status === 0) {
      writeSwitchState({
        timestamp: Date.now(),
        fromEmail: fromEmail || null,
        pid: process.pid,
      });
      return { ok: true, skipped: false };
    }
    return { ok: false, skipped: false };
  } finally {
    if (locked) releaseSwitchLock();
  }
}

function emitSwitchEvent({ ok, category, reason, skipped, from }) {
  // Machine-readable contract for the ACP plugin; stderr only, exactly one line.
  try {
    const payload = {
      ok: ok === true,
      category: category || 'UNKNOWN',
      ...(skipped ? { skipped: true } : {}),
      ...(reason ? { reason: String(reason) } : {}),
      from: from || '',
      ts: Date.now(),
    };
    console.error(`[agy-switch] ${JSON.stringify(payload)}`);
  } catch {
    // Observability must never break the wrapper.
  }
}

function getArgConversationId(args) {
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--conversation' && args[i + 1]) return args[i + 1];
    if (args[i].startsWith('--conversation=')) return args[i].slice('--conversation='.length);
  }
  return null;
}

function getArgModel(args) {
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--model' && args[i + 1]) return args[i + 1];
    if (args[i].startsWith('--model=')) return args[i].slice('--model='.length);
  }
  return null;
}

function classifyModelPool(state, args) {
  const candidates = [state.model, state.modelLabel, getArgModel(args)]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  if (!candidates) return 'unknown';
  if (candidates.includes('argon') || candidates.includes('orchestrator')) return 'argon';
  if (candidates.includes('claude') || candidates.includes('gpt')) return '3p';
  if (candidates.includes('gemini')) return 'gemini';
  return 'unknown';
}

function expandHome(p) {
  if (!p) return p;
  if (p === '~') return os.homedir();
  if (p.startsWith(`~${path.sep}`) || p.startsWith('~/')) {
    return path.join(os.homedir(), p.slice(2));
  }
  return p;
}

function resolveAtDataDir() {
  const envDir =
    process.env.ABV_DATA_DIR ||
    process.env.ANTIGRAVITY_TOOLS_DATA_DIR ||
    process.env.AGY_DATA_DIR;
  if (envDir) return path.resolve(expandHome(envDir));

  const pointerFile =
    process.env.ABV_DATA_DIR_POINTER_FILE ||
    path.join(os.homedir(), '.antigravity_tools_location');
  try {
    if (fs.existsSync(pointerFile)) {
      const target = fs.readFileSync(pointerFile, 'utf8').trim();
      if (target) return path.resolve(expandHome(target));
    }
  } catch {
    // 忽略指针文件读取异常
  }

  return path.join(os.homedir(), '.antigravity_tools');
}

function queryLocalQuotaSummary(email) {
  try {
    const baseDir = resolveAtDataDir();
    const idxPath = process.env.AGY_ACCOUNTS_FILE
      ? path.resolve(expandHome(process.env.AGY_ACCOUNTS_FILE))
      : path.join(baseDir, 'accounts.json');
    if (!fs.existsSync(idxPath)) return null;
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    const acc =
      (email && idx.accounts?.find((a) => a.email === email)) ||
      (idx.current_agy_account_id && idx.accounts?.find((a) => a.id === idx.current_agy_account_id));
    if (!acc?.id) return null;

    const accountsDir = process.env.AGY_ACCOUNTS_DIR
      ? path.resolve(expandHome(process.env.AGY_ACCOUNTS_DIR))
      : path.join(path.dirname(idxPath), 'accounts');
    const detailPath = path.join(accountsDir, `${acc.id}.json`);
    if (!fs.existsSync(detailPath)) return null;
    const detail = JSON.parse(fs.readFileSync(detailPath, 'utf8'));
    const groups = detail?.quota?.quota_groups;
    if (!Array.isArray(groups) || groups.length === 0) return null;

    const geminiGroup = groups.find((g) => /gemini models/i.test(g.display_name || ''));
    const geminiBuckets = geminiGroup?.buckets || [];
    const geminiPoolHasQuota =
      geminiBuckets.length > 0 && geminiBuckets.every((b) => (b.remaining_fraction ?? 0) > 0);

    const summaryLines = groups.map((g) => {
      const bText = (g.buckets || [])
        .map((b) => `${b.window || b.bucket_id}: ${((b.remaining_fraction ?? 0) * 100).toFixed(1)}%`)
        .join(', ');
      return `${g.display_name}: ${bText || 'N/A'}`;
    });

    const updatedAt = detail?.quota?.last_updated
      ? new Date(detail.quota.last_updated * 1000).toLocaleTimeString('zh-CN', { hour12: false })
      : null;

    return {
      email: detail.email || email,
      geminiPoolHasQuota,
      summaryLines,
      updatedAt,
    };
  } catch {
    return null;
  }
}

function evaluateQuotaSwitch(state, args) {
  const pool = classifyModelPool(state, args);
  const quota = queryLocalQuotaSummary(state.email);
  const forceSwitch = process.env.AGY_FORCE_SWITCH_ON_429 === '1';

  if (
    !forceSwitch &&
    (pool === 'argon' || pool === '3p') &&
    quota &&
    quota.geminiPoolHasQuota
  ) {
    return {
      shouldSwitch: false,
      pool,
      quota,
      reason: `仅独立池 (${pool === 'argon' ? 'Gemini 4 Argon' : 'Claude/GPT'}) 额度耗尽，主池 [Gemini Models] 仍有剩余额度，不切号`,
    };
  }

  return {
    shouldSwitch: true,
    pool,
    quota,
    reason: null,
  };
}

async function runOnce(args, attempt, { acpMode = false } = {}) {
  const interactive = !acpMode && !isPrintMode(args);
  const existingLogFile = hasLogFileFlag(args);
  const logFile = existingLogFile || createLogFilePath(attempt, acpMode ? 'acp' : 'cli');
  let finalArgs = args;
  if (!existingLogFile) {
    if (acpMode) {
      const acpIdx = args.indexOf('acp');
      finalArgs = [
        ...args.slice(0, acpIdx + 1),
        '--log-file',
        logFile,
        ...args.slice(acpIdx + 1),
      ];
    } else {
      finalArgs = ['--log-file', logFile, ...args];
    }
  }

  const state = {
    email: null,
    model: null,
    modelLabel: null,
    conversationId: getArgConversationId(args),
    error: null,
    killedByMonitor: false,
    acpHandledError: false,
  };

  let offset = 0;
  let remainder = '';

  const readNewLogLines = () => {
    try {
      if (!fs.existsSync(logFile)) return;
      const stat = fs.statSync(logFile);
      if (stat.size <= offset) return;
      const length = stat.size - offset;
      const buf = Buffer.alloc(length);
      const fd = fs.openSync(logFile, 'r');
      try {
        fs.readSync(fd, buf, 0, length, offset);
      } finally {
        fs.closeSync(fd);
      }
      offset = stat.size;
      const chunk = remainder + buf.toString('utf8');
      const lines = chunk.split(/\r?\n/);
      remainder = lines.pop() ?? '';
      for (const line of lines) {
        if (line) inspectLogLine(line, state);
      }
    } catch {
      // 忽略读取异常
    }
  };

  return new Promise((resolve) => {
    const child = spawn(AGY_BIN, finalArgs, {
      stdio: 'inherit',
      env: process.env,
    });

    const timer = setInterval(() => {
      readNewLogLines();
      if (acpMode && state.error?.shouldSwitch && !state.acpHandledError) {
        state.acpHandledError = true;
        const accountInfo = state.email ? ` [账号: ${state.email}]` : '';
        console.error(`\n[Antigravity ACP] 检测到异常: ${state.error.label}${accountInfo}`);
        if (state.error.detail) {
          console.error(`  └─ 详情: ${state.error.detail}`);
        }
        let doSwitch = true;
        let skipReason = null;
        const category = state.error.category;
        const fromEmail = state.email || '';
        if (category === 'QUOTA_EXHAUSTED' || category === 'UNAVAILABLE_CAPACITY') {
          const evalRes = evaluateQuotaSwitch(state, args);
          if (evalRes.quota) {
            console.error(`  └─ 当前配额快照 (${evalRes.quota.updatedAt || '缓存'}): ${evalRes.quota.summaryLines.join(' | ')}`);
          }
          if (!evalRes.shouldSwitch) {
            doSwitch = false;
            skipReason = evalRes.reason;
            console.error(`[Antigravity ACP] ${evalRes.reason}，跳过切号。`);
          }
        }
        if (!doSwitch) {
          emitSwitchEvent({ ok: false, category, skipped: true, reason: skipReason, from: fromEmail });
        } else if (process.env.AGY_NO_AUTO_SWITCH === '1') {
          emitSwitchEvent({ ok: false, category, skipped: true, reason: 'AGY_NO_AUTO_SWITCH=1', from: fromEmail });
        } else if (!hasAntigravityTools()) {
          emitSwitchEvent({ ok: false, category, reason: 'antigravity-tools-not-found', from: fromEmail });
        } else {
          console.error(`[Antigravity ACP] 正在预切换账号 (Keychain)...`);
          const sw = switchAccount(state.email);
          if (sw.ok && !sw.skipped) {
            console.error(`[Antigravity ACP] 账号已切换；注意运行中的 ACP 进程缓存旧凭证，需新建/重连 ACP 进程后生效。`);
            emitSwitchEvent({ ok: true, category, from: fromEmail });
          } else if (sw.ok && sw.skipped) {
            emitSwitchEvent({ ok: false, category, skipped: true, reason: 'switch-cooldown', from: fromEmail });
          } else {
            console.error(`[Antigravity ACP] 账号切换失败。`);
            emitSwitchEvent({ ok: false, category, reason: 'switch-failed', from: fromEmail });
          }
        }
      }
      if (interactive && state.error?.killInteractive && !state.killedByMonitor) {
        let shouldKill = true;
        if (state.error.category === 'QUOTA_EXHAUSTED') {
          const evalRes = evaluateQuotaSwitch(state, args);
          if (!evalRes.shouldSwitch) {
            shouldKill = false;
            if (!state.partialQuotaNotified) {
              state.partialQuotaNotified = true;
              console.error(`\n\x1b[33m[Antigravity] ${evalRes.reason}。\x1b[0m`);
              if (evalRes.quota) {
                console.error(`\x1b[90m  └─ 配额快照 (${evalRes.quota.updatedAt || '缓存'}): ${evalRes.quota.summaryLines.join(' | ')}\x1b[0m`);
              }
            }
          }
        }
        if (shouldKill) {
          state.killedByMonitor = true;
          setTimeout(() => {
            try {
              child.kill('SIGTERM');
            } catch {}
          }, 250);
        }
      }
    }, 120);

    const forwardSignal = (sig) => {
      state.userInterrupted = true;
      try {
        child.kill(sig);
      } catch {}
    };

    process.on('SIGINT', forwardSignal);
    process.on('SIGTERM', forwardSignal);

    child.on('close', (code, signal) => {
      clearInterval(timer);
      process.removeListener('SIGINT', forwardSignal);
      process.removeListener('SIGTERM', forwardSignal);

      readNewLogLines();
      if (remainder) {
        inspectLogLine(remainder, state);
        remainder = '';
      }

      resolve({
        exitCode: code ?? (signal ? 128 : 1),
        signal,
        state,
      });
    });
  });
}

async function main() {
  // ACP 模式：注入 /tmp/ 日志监控并保持 stdio JSON-RPC 透传（不注入 --model，不强杀进程）
  if (isAcpMode(rawUserArgs)) {
    const { exitCode } = await runOnce(rawUserArgs, 1, { acpMode: true });
    process.exit(exitCode);
  }

  // 子命令或 --help 直接透传执行
  if (isSubcommandOrHelp(rawUserArgs)) {
    const res = spawnSync(AGY_BIN, rawUserArgs, { stdio: 'inherit', env: process.env });
    process.exit(res.status ?? 0);
  }

  let currentUserArgs = [...rawUserArgs];
  let lastConversationId = getArgConversationId(rawUserArgs);
  const modelArgs = buildModelArgs(config.rawModel, currentUserArgs);
  const MAX_SWITCH_RETRIES = 5;
  let switchCount = 0;
  let attempt = 1;

  while (true) {
    const runArgs = [...modelArgs, ...currentUserArgs];
    const { exitCode, signal, state } = await runOnce(runArgs, attempt++);
    if (state.conversationId) {
      lastConversationId = state.conversationId;
    }

    // 1. 正常退出或用户主动 Ctrl+C 中断
    if (exitCode === 0 && !state.killedByMonitor) {
      process.exit(0);
    }
    if (state.userInterrupted || signal === 'SIGINT' || exitCode === 130) {
      process.exit(exitCode || 130);
    }

    // 3. 判断是否需要切号（日志明确识别到账号/配额错误，或 agy_cli 返回运行时错误码 3）
    const shouldSwitch =
      state.error?.shouldSwitch ||
      (exitCode === 3 && !state.error);

    if (!shouldSwitch) {
      process.exit(exitCode);
    }

    const reasonLabel = state.error?.label || `会话运行异常 (Exit Code ${exitCode})`;
    const accountInfo = state.email ? ` [账号: ${state.email}]` : '';
    const switchCategory = state.error?.category || 'UNKNOWN';
    const fromEmail = state.email || '';
    console.error(`\n\x1b[33m[Antigravity] 检测到异常: ${reasonLabel}${accountInfo}\x1b[0m`);
    if (state.error?.detail) {
      console.error(`\x1b[90m  └─ 详情: ${state.error.detail}\x1b[0m`);
    }

    if (state.error?.category === 'QUOTA_EXHAUSTED' || state.error?.category === 'UNAVAILABLE_CAPACITY') {
      const evalRes = evaluateQuotaSwitch(state, runArgs);
      if (evalRes.quota) {
        console.error(
          `\x1b[90m  └─ 配额快照 (${evalRes.quota.updatedAt || '缓存'}): ${evalRes.quota.summaryLines.join(' | ')}\x1b[0m`
        );
      }
      if (!evalRes.shouldSwitch) {
        emitSwitchEvent({ ok: false, category: switchCategory, skipped: true, reason: evalRes.reason, from: fromEmail });
        console.error(`\x1b[32m[Antigravity] ${evalRes.reason}。可直接切换至 Gemini 4 Hydrogen / Gemini 3.8 Flash 继续使用（强制切号请设 AGY_FORCE_SWITCH_ON_429=1）。\x1b[0m\n`);
        process.exit(exitCode || 1);
      }
    }

    if (process.env.AGY_NO_AUTO_SWITCH === '1') {
      emitSwitchEvent({ ok: false, category: switchCategory, skipped: true, reason: 'AGY_NO_AUTO_SWITCH=1', from: fromEmail });
      console.error(`\x1b[33m[Antigravity] 已设置 AGY_NO_AUTO_SWITCH=1，跳过自动切号。\x1b[0m\n`);
      process.exit(exitCode || 1);
    }

    if (switchCount >= MAX_SWITCH_RETRIES) {
      emitSwitchEvent({ ok: false, category: switchCategory, skipped: true, reason: 'max-switch-retries', from: fromEmail });
      console.error(`\x1b[31m[Antigravity] 已连续切号 ${MAX_SWITCH_RETRIES} 次仍失败，停止重试。\x1b[0m\n`);
      process.exit(exitCode || 1);
    }

    if (!hasAntigravityTools()) {
      emitSwitchEvent({ ok: false, category: switchCategory, reason: 'antigravity-tools-not-found', from: fromEmail });
      console.error(`\x1b[31m[Antigravity] 未找到 antigravity-tools，无法自动切号。\x1b[0m\n`);
      process.exit(exitCode || 1);
    }

    console.error(`\x1b[33m[Antigravity] 正在自动顺延切换账号 (${switchCount + 1}/${MAX_SWITCH_RETRIES})...\x1b[0m`);
    const sw = switchAccount(state.email);
    if (sw.ok) {
      switchCount++;
      if (sw.skipped) {
        emitSwitchEvent({ ok: false, category: switchCategory, skipped: true, reason: 'switch-cooldown', from: fromEmail });
      } else {
        emitSwitchEvent({ ok: true, category: switchCategory, from: fromEmail });
      }
      if (sw.skipped && SWITCH_RESUME_DELAY_MS > 0) {
        const waitSec = (SWITCH_RESUME_DELAY_MS / 1000).toFixed(1).replace(/\.0$/, '');
        console.error(`\x1b[90m[Antigravity] 等待 ${waitSec}s 后再恢复会话...\x1b[0m`);
        await new Promise((resolve) => setTimeout(resolve, SWITCH_RESUME_DELAY_MS));
      }
      if (isPrintMode(currentUserArgs)) {
        console.error(`\x1b[32m[Antigravity] 账号切换成功，正在重新执行请求...\x1b[0m\n`);
      } else if (lastConversationId) {
        console.error(`\x1b[32m[Antigravity] 账号切换成功，正在以 --conversation ${lastConversationId} 精确恢复会话...\x1b[0m\n`);
        currentUserArgs = ['--conversation', lastConversationId];
      } else {
        console.error(`\x1b[32m[Antigravity] 账号切换成功，正在以 --continue 恢复会话...\x1b[0m\n`);
        currentUserArgs = ['--continue'];
      }
      continue;
    } else {
      emitSwitchEvent({ ok: false, category: switchCategory, reason: 'switch-failed', from: fromEmail });
      console.error(`\x1b[31m[Antigravity] 账号切换失败。\x1b[0m\n`);
      process.exit(exitCode || 1);
    }
  }
}

main().catch((err) => {
  console.error('[Antigravity] Wrapper error:', err);
  process.exit(1);
});
