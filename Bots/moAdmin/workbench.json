{
  "panels": [
    "chat",
    "explorer",
    "terminal"
  ],
  "activePanel": "chat",
  "theme": "system",
  "defaultWorkingDir": ".",
  "allowedWritePaths": [
    "groups/",
    "Customizations/group/",
    "docs/",
    "logs/"
  ],
  "disallowedWritePaths": [
    "src/",
    "test/",
    "~/.claude",
    ".env"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
