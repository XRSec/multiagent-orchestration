{
  "panels": [
    "chat",
    "explorer",
    "terminal"
  ],
  "activePanel": "chat",
  "theme": "system",
  "defaultWorkingDir": "Customizations",
  "allowedWritePaths": [
    "Customizations/skills/",
    "Customizations/agents/<NewBot>/",
    "Bots/<NewBot>/"
  ],
  "disallowedWritePaths": [
    "src/",
    "~/.claude",
    ".env"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
