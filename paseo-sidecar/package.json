{
  "name": "paseo-sidecar",
  "version": "0.1.0",
  "description": "Multi-runtime sidecar MCP server for hook dispatch, plugin normalization, and workspace routing",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./paseo-adapter": "./dist/paseo/adapter.js"
  },
  "bin": {
    "sidecar": "./bin/sidecar",
    "sidecar-hook-shim": "./bin/sidecar-hook-shim"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/cli/index.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
