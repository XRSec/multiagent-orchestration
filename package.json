{
  "name": "multiagent-orchestration-root",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-agent orchestration workspace root with web frontend",
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "gateway:start": "tsx src/daemon/cli.ts start",
    "gateway:status": "tsx src/daemon/cli.ts status",
    "gateway:ping": "tsx src/daemon/cli.ts ping",
    "gateway:list-bots": "tsx src/daemon/cli.ts list-bots",
    "gateway:stop": "tsx src/daemon/cli.ts stop",
    "test:e2e": "tsx test/e2e/run-all-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "zod": "^4.6.7"
  }
}
